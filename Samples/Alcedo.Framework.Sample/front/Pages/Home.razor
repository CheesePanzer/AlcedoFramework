@page "/"
@using Alcedo.Frontend.Blazor
@using MudBlazor

<PageTitle>Alcedo Atthis</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex align-center justify-center" Style="min-height: 80vh;">

    <MudPaper Elevation="4"
              Class="d-flex flex-column align-center justify-center text-center pa-12 rounded-xl position-relative overflow-hidden">

        <AlcedoLogo Width="96" Height="96" Class="mb-4"/>

        <MudText Typo="Typo.h5"
                 Color="Color.Info"
                 Style="font-weight: 500; letter-spacing: .15rem; text-transform: uppercase;"
                 Class="mb-2">
            @_greeting
        </MudText>

        <MudText Typo="Typo.h2"
                 Color="Color.Primary"
                 GutterBottom="true"
                 Style="font-weight: 900; letter-spacing: .05rem;">
            Alcedo Atthis
        </MudText>

        <MudDivider DividerType="DividerType.Middle"
                    Class="my-4"
                    Style="width: 60px; height: 3px; background-color: var(--mud-palette-primary); border-radius: 2px;"/>

        <MudText Typo="Typo.h6"
                 Color="Color.Default"
                 Class="mx-auto mt-2"
                 Style="max-width: 550px; font-weight: 400; line-height: 1.6;">
            The frontend for Alcedo Atthis Management Framework
        </MudText>

    </MudPaper>

</MudContainer>

@code {
    private string _greeting = "Welcome";

    protected override void OnInitialized()
    {
        var hour = DateTime.Now.Hour;
        if (hour >= 5 && hour < 12)
        {
            _greeting = "Good Morning";
        }
        else if (hour >= 12 && hour < 18)
        {
            _greeting = "Good Afternoon";
        }
        else
        {
            _greeting = "Good Evening";
        }
    }

}
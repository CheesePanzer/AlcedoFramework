# Copy this file to .env and replace every change-me value before deployment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
SAMPLE_DATABASE=alcedo_framework_sample
REDIS_PASSWORD=change-me-redis

# Generate independent 32-byte Base64 values, for example:
# openssl rand -base64 32
SAMPLE_JWT_KEY=change-me-base64-jwt-key
SAMPLE_ENCRYPTOR_KEY=change-me-base64-encryption-key

# SeaweedFS S3 credentials. Create these in the SeaweedFS admin console.
SAMPLE_AWS_ACCESS_KEY=change-me-s3-access-key
SAMPLE_AWS_SECRET_KEY=change-me-s3-secret-key

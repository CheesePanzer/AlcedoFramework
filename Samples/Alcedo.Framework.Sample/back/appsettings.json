{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] [{TraceId:l}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] [{TraceId:l}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "AlcedoCorsOptions": {
    "AllowedOrigins": [
      "https://localhost:7041",
      "http://localhost:5173"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization",
      "X-Refresh-Token",
      "X-Idempotency-Key",
      "X-Js-Submit"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "PATCH"
    ]
  },
  "AlcedoForwardedHeadersOptions": {
    "KnownProxies": "127.0.0.1"
  },
  "IdempotencyKeyOptions": {
    "StrictKeyExpireMinutes": 10,
    "CommonKeyExpireMinutes": 1
  },
  "DataSourceOptions": {
    "RabbitMQ": {
      "Host": "{MqHost}",
      "Port": 5672,
      "VirtualHost": "{VHost:/}",
      "Username": "{MqUser:admin}",
      "Password": "{MqPassword}"
    },
    "Postgres": "Host={DataBaseHost};Database={DataBaseName};Username={DataBaseUser};Password={DataBasePassword}",
    "Redis": "{RedisHost}:{RedisPort:6379},password={RedisPassword},defaultDatabase=0"
  },
  "RedisOptions": {
    "GlobalPrefix": "Alcedo"
  },
  "MsgQueueOptions": {
    "RetryCount": 5,
    "RetryIntervalSecs": 5,
    "PrefetchCount": 16,
    "ConcurrentMessageLimit": 8,
    "ServiceName": "Alcedo"
  },
  "SmtpOptions": {
    "Host": "localhost",
    "Port": 25,
    "Username": "",
    "Password": "",
    "UseSsl": false,
    "FromEmail": "noreply@alcedo.com",
    "FromName": "Alcedo"
  },
  "AWS": {
    "ServiceURL": "http://127.0.0.1:8333",
    "ForcePathStyle": true
  },
  "AwsCredentials": {
    "AccessKey": "{YOUR_ACCESS_KEY}",
    "SecretKey": "{YOUR_SECRET_KEY}"
  },
  "StorageOptions": 
  {
    "S3PublicUrl": "http://127.0.0.1:8333"
  },
  "AlcedoColumnEncryptorOptions": {
    "Key": "{YOUR_SECRET_KEY}"
  },
  "JwtOptions": {
    "Issuer": "{Alcedo}",
    "Audience": "{AlcedoUser}",
    "Algorithm": "HS256",
    "Key": "{YOUR_SECRET_KEY}"
  },
  "SecurityOptions": {
    "LoginFailedTTLSeconds": 60,
    "AccountLockThresholdCount": 5,
    "LoginContextValiditySeconds": 180,
    "AccessTokenValidMinutes": 15,
    "RefreshTokenValidMinutes": 480
  },
  "TotpOptions": {
    "Issuer": "Alcedo"
  },
  "RbacSchemeOptions": {
    "RoleCacheExpiryMinutes": 120
  },
  "AccessLogOptions": {
    "BatchFetchSize": 500
  },
  "NotificationOptions": {
    "MessageCacheGlobalExpiryMins": 120
  }
}

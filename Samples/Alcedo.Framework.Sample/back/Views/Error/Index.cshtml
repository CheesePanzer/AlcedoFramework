@model Alcedo.Core.Presentation.Mvc.ViewModels.ErrorVm
@{
    Layout = null;
    var status = Model.Status > 0 ? Model.Status : 500;
    var title = string.IsNullOrWhiteSpace(Model.Title) ? "Something went wrong" : Model.Title;
}
<!DOCTYPE html>
<html lang="en" data-theme="lemonade">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@status - Juice Lab</title>
    @await Html.PartialAsync("_AlcedoMvcCoreHead")
    @await Html.PartialAsync("_AlcedoMvcDaisyUIHead")
</head>
<body class="min-h-screen bg-base-200 text-base-content">
<main class="hero min-h-screen px-5">
    <div class="hero-content text-center">
        <div class="max-w-xl">
            <div class="badge badge-error badge-outline font-mono">ERROR @status</div>
            <h1 class="mt-5 text-5xl font-black sm:text-7xl">Something went sour.</h1>
            <p class="mt-5 text-xl opacity-70">@title</p>
            @if (!string.IsNullOrWhiteSpace(Model.Detail))
            {
                <p class="mt-3 opacity-60">@Model.Detail</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.TraceId))
            {
                <p class="mt-6 font-mono text-xs opacity-45">Trace ID: @Model.TraceId</p>
            }
            <div class="mt-9 flex justify-center gap-3">
                <button type="button" class="btn btn-outline" onclick="window.location.reload()">Try again</button>
                <a href="/juices" class="btn btn-primary">Back to the catalog</a>
            </div>
        </div>
    </div>
</main>
</body>
</html>

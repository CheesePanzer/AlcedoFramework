@using Alcedo.Frontend.Abstraction.Helpers

<MudTextField Value="@Value"
              ValueChanged="@(EventCallback.Factory.Create<string?>(this, OnValueChanged))"
              For="@ValueExpression"
              Label="@Label"
              InputType="InputType.Password"
              Variant="Variant.Outlined"
              Error="@Error"
              ErrorText="@ErrorText"/>

@if (!string.IsNullOrEmpty(Value))
{
    <MudStack Spacing="1" Class="mt-1">
        <MudProgressLinear Value="@StrengthPercent"
                           Color="@StrengthColor"
                           Rounded="true"
                           Size="Size.Small"/>
        <MudText Typo="Typo.caption" Color="@StrengthColor">@StrengthLabel</MudText>
    </MudStack>
}

@code {
    [Parameter] public string? Value { get; set; } = "";
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<string?>>? ValueExpression { get; set; }
    [Parameter] public string Label { get; set; } = "New Password";
    [Parameter] public bool Error { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public EventCallback<bool> IsValidChanged { get; set; }

    private int Strength => PasswordStrengthChecker.GetStrength(Value ?? "");
    private double StrengthPercent => Math.Min(Strength * 25, 100);
    private bool IsStrongEnough => Strength >= 3;

    private Color StrengthColor => Strength switch
    {
        0 or 1 => Color.Error,
        2 => Color.Warning,
        3 => Color.Info,
        _ => Color.Success
    };

    private string StrengthLabel => Strength switch
    {
        0 or 1 => "Very weak",
        2 => "Weak",
        3 => "Good",
        _ => "Strong"
    };

    private async Task OnValueChanged(string? newValue)
    {
        Value = newValue ?? "";
        await ValueChanged.InvokeAsync(Value);
        await IsValidChanged.InvokeAsync(IsStrongEnough);
    }

}
@using Alcedo.Frontend.Abstraction.Helpers
@using Alcedo.Frontend.Identity.Clients.Auth
@using Alcedo.Frontend.Identity.Providers
@inject IAuthClient AuthClient
@inject AuthStateProvider AuthProvider
@inject AlcedoRequestService RequestService

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.Key" Color="Color.Primary"/>
            <MudText Typo="Typo.h6" Style="font-weight:900; font-style:italic; text-transform:uppercase;">
                Change Password
            </MudText>
        </MudStack>
        @if (MustChange)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning">
                Initial password detected. Please reset.
            </MudText>
        }
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_oldPassword"
                          Label="Current Password"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"/>

            <PasswordStrengthInput Value="@_newPassword"
                                   ValueChanged="@((string? v) => _newPassword = v ?? "")"
                                   Label="New Password"
                                   Error="@IsSameAsOld"
                                   ErrorText="Must be different from current password"
                                   IsValidChanged="@(v => IsStrongEnough = v)"/>

            <MudTextField @bind-Value="_confirmPassword"
                          Label="Confirm Password"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Error="@(!IsPasswordMatch && !string.IsNullOrEmpty(_confirmPassword))"
                          ErrorText="Passwords do not match"/>
        </MudStack>
    </DialogContent>

    <DialogActions>
        @if (!MustChange)
        {
            <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">Cancel</MudButton>
        }
        <MudButton OnClick="Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!CanSubmit || _isLoading)"
                   FullWidth="@MustChange">
            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                <span>Processing...</span>
            }
            else
            {
                <span>@SubmitLabel</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool MustChange { get; set; }
    [Parameter] public EventCallback OnSuccess { get; set; }

    private UserChangePasswordCommand _command = new();
    private string _oldPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _isLoading;

    private bool IsSameAsOld => !string.IsNullOrEmpty(_newPassword) && _newPassword == _oldPassword;
    private bool IsPasswordMatch => _newPassword == _confirmPassword;
    private bool IsStrongEnough { get; set; }

    private bool CanSubmit => !string.IsNullOrEmpty(_oldPassword)
                              && !string.IsNullOrEmpty(_newPassword)
                              && IsPasswordMatch
                              && IsStrongEnough
                              && !IsSameAsOld;

    private string SubmitLabel => IsSameAsOld ? "Old = New"
        : (!IsStrongEnough && !string.IsNullOrEmpty(_newPassword)) ? "Too Weak"
        : "Confirm Update";

    private int Strength => PasswordStrengthChecker.GetStrength(_newPassword);

    private async Task Submit()
    {
        if (!CanSubmit)
        {
            return;
        }

        _isLoading = true;
        try
        {
            await RequestService.ExecuteAsync(() => AuthClient.ChangePasswordAsync(new UserChangePasswordCommand
            {
                OldPassword = _oldPassword,
                NewPassword = _newPassword
            }));

            await OnSuccess.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
@page "/identity/log/loginlog"
@using Alcedo.Frontend.Abstraction.Dto
@using Alcedo.Frontend.Abstraction.SearchQuery
@using Alcedo.Frontend.Blazor.Components
@using Alcedo.Frontend.Blazor.Components.Auto
@using Alcedo.Frontend.Identity.Clients.Log
@inject AlcedoRequestService RequestService
@inject ILogClient LogClient

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">
    <MudToolBar Dense="true" Class="px-0 mb-4">
        <MudText Typo="Typo.h4">Login Logs</MudText>
    </MudToolBar>

    <AutoSearch TQuery="LoginLogSearchQuery"
                Query="_searchQuery"
                SortQuery="_sortQuery"
                SortFields="SortFields"
                OnSearch="ExecuteSearch" />

    @if (_pagedResult is not null)
    {
        <AutoTable TItem="LoginLogDto"
                   Items="_pagedResult.Items"/>
        <Pagination Query="_paginationQuery"
                    OnChanged="LoadPagedResult"
                    TotalItems="_pagedResult.TotalCount" />
    }
    else
    {
        <MudAlert Severity="Severity.Info">Table Has No Records</MudAlert>
    }
</MudContainer>

@code {
    private LoginLogSearchQuery _searchQuery = new();
    private SortQuery _sortQuery = new()
    {
        Fields = [new SortField()
        {
            Field = nameof(LoginLogDto.LoginAt),
            Descending = true
        }],
    };
    private PaginationQuery _paginationQuery = new();
    private PagedResult<LoginLogDto>? _pagedResult;
    private IReadOnlyCollection<LoginLogDto> _selectedItems = [];
    public IReadOnlyList<string>? SortFields { get; set; } = [nameof(LoginLogDto.LoginAt)];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadPagedResult();
            StateHasChanged();
        }
    }

    private async Task ExecuteSearch()
    {
        _paginationQuery.PageNo = 1;
        await LoadPagedResult();
    }

    private async Task LoadPagedResult()
        => _pagedResult = await RequestService.ExecuteAsync(
            () => LogClient.GetListAsync(_searchQuery, _sortQuery, _paginationQuery));
}
@page "/password-change"
@layout EmptyLayout
@using Alcedo.Frontend.Blazor.Layout
@using Alcedo.Frontend.Identity.Components
@using Alcedo.Frontend.Identity.Providers
@inject IDialogService DialogService
@inject AuthStateProvider AuthProvider

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudCard Outlined="true" Class="pa-6">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" FontStyle="FontStyle.Normal" Class="font-weight-bold">Security Action Required
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Square="false" Class="my-2">
                You cannot proceed until you have changed your initial password successfully!
            </MudAlert>
        </MudCardContent>

        <MudCardActions Class="d-flex justify-end pa-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Medium"
                       StartIcon="@Icons.Material.Filled.Lock"
                       OnClick="@OpenChangePasswordDialog">
                Change Password
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {

    private async Task OpenChangePasswordDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var parameters = new DialogParameters { ["MustChange"] = false };
        parameters.Add("OnSuccess", EventCallback.Factory.Create(this, AuthProvider.ClearAsync));
        await DialogService.ShowAsync<ChangePasswordDialog>("Change Password", parameters, options);
    }

}